---
import Base from "../layouts/Base.astro";
---
<Base title="Page not found | Charlotte Smith" description="This page doesn't exist." noindex>
  <section class="section">
    <div class="wrap stack center" style="max-width: 760px; text-align: center; gap: 22px;">
      <p class="eyebrow"><span class="star" aria-hidden="true">✦</span>404</p>
      <h1 class="display" style="font-size: clamp(40px, 5vw, 64px);">This page has <span class="accent">wandered off.</span></h1>
      <p class="lead" style="margin-inline: auto;">The page you're looking for doesn't exist or has moved.</p>
      <div class="btn-row" style="justify-content: center;"><a class="btn btn-dark" href="/">Back to home</a><a class="btn btn-line" href="/contact/">Contact me</a></div>
    </div>
  </section>
</Base>
