---
import { Image } from "astro:assets";
import Base from "../layouts/Base.astro";
import Ticker from "../components/Ticker.astro";
import LogoStrip from "../components/LogoStrip.astro";
import ServicesBento from "../components/ServicesBento.astro";
import PackageTeaser from "../components/PackageTeaser.astro";
import ProjectCard from "../components/ProjectCard.astro";
import CtaBand from "../components/CtaBand.astro";
import { site } from "../data/site";
import { projects } from "../data/projects";
import hero from "../assets/photos/charlotte-smith-linen-dress.webp";
import intro from "../assets/photos/charlotte-smith-black.png";
import marble from "../assets/textures/noir-marble.webp";

const work = ["general-copper-gold", "maltamove", "dar-il-fwieha"].map((s) => projects.find((p) => p.slug === s)!);
---
<Base title={site.title} description={site.description}>
  <!-- Hero -->
  <section class="hero" aria-labelledby="hero-title" style={`background-image: url(${marble.src});`}>
    <div class="wrap hero-grid">
      <div class="hero-copy">
        <p class="eyebrow rise"><span class="rule" aria-hidden="true"></span>Marketing consultant</p>
        <h1 id="hero-title" class="rise d1">Marketing that helps your business <span class="foil">shine.</span></h1>
        <p class="sub rise d2">Social media, branding, websites, SEO, ads and lead generation for growing businesses, wherever they are.</p>
        <div class="btn-row rise d3">
          <a class="btn btn-gold" href="/packages/">See packages from €45</a>
          <a class="btn btn-ghost" href="/contact/">Book a call</a>
        </div>
      </div>

      <div class="collage fade-in">
        <div class="stage">
          <span class="arch-line" aria-hidden="true"></span>
          <div class="arch">
            <Image src={hero} alt="Charlotte Smith in a white linen dress with gold and pearl necklaces" widths={[380, 570, 760]} sizes="(max-width: 700px) 190px, 380px" loading="eager" fetchpriority="high" />
          </div>

          <div class="browser" aria-hidden="true">
            <div class="bbar"><i></i><i></i><i></i><span>yourbusiness.com</span></div>
            <div class="bhero"><strong>A website that books clients</strong><s></s><s class="short"></s><em>Book now</em></div>
            <div class="bgrid"><i></i><i></i><i></i></div>
          </div>

          <div class="phone" aria-hidden="true">
            <div class="screen">
              <div class="ph-head"><span class="av">yb</span><span><b>yourbusiness</b><small>Instagram feed</small></span></div>
              <div class="ph-grid">
                <span class="t noir">3 signs your website needs care</span><span class="blush"></span><span class="gold it">New</span>
                <span class="t linen">Google profile checklist</span><span class="noir"></span><span class="rose"></span>
                <span class="blush it">Tips</span><span class="gold"></span><span class="t noir">Meet the team</span>
              </div>
            </div>
          </div>

          <div class="serp" aria-hidden="true">
            <div class="q"><svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="#6B6560" stroke-width="1.6"><circle cx="11" cy="11" r="7"></circle><path d="M21 21l-5-5"></path></svg>salon near me</div>
            <small>yourbusiness.com</small><b>Your Business · Book online</b><s></s><s class="short"></s>
          </div>

          <div class="chips" aria-hidden="true">
            <span><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="#E8D3A2" stroke-width="1.3"><rect x="3" y="5" width="18" height="14" rx="1"></rect><path d="M3 6l9 7 9-7"></path></svg>Welcome email sent</span>
            <span><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="#E8D3A2" stroke-width="1.3"><path d="M4 20V10M10 20V4M16 20v-7M22 20H2"></path></svg>Ad campaign live</span>
          </div>
        </div>
        <p class="illus">Illustrative examples</p>
      </div>
    </div>
  </section>

  <Ticker />
  <LogoStrip />
  <ServicesBento />

  <!-- Intro -->
  <section class="intro" aria-labelledby="intro-title">
    <div class="wrap intro-grid">
      <div class="intro-photo reveal">
        <span class="disc" aria-hidden="true"></span>
        <Image src={intro} alt="Charlotte Smith in a black top with arms folded" widths={[300, 450, 600]} sizes="(max-width: 760px) 260px, 340px" />
      </div>
      <div class="stack reveal" style="gap: 20px;">
        <p class="eyebrow">About me</p>
        <h2 id="intro-title" class="h2" style="font-weight: 400;">Hi, I'm <span class="accent">Charlotte.</span></h2>
        <p class="lead" style="max-width: 560px;">I've spent 9+ years in marketing, across brand, social, websites, campaigns, email and CRM. I bring strategy and design together so your marketing looks polished and works hard to bring in enquiries.</p>
        <div class="btn-row"><a class="btn btn-dark" href="/about/">More about me</a></div>
      </div>
    </div>
  </section>

  <!-- Selected work -->
  <section class="section work" aria-labelledby="work-title">
    <div class="wrap stack-lg">
      <div class="head-row">
        <h2 id="work-title" class="h2" style="font-weight: 400;">Selected <span class="accent">work</span></h2>
        <a class="textlink" href="/work/"><span>View all projects</span></a>
      </div>
      <div class="grid-3">
        {work.map((p) => <div class="reveal"><ProjectCard project={p} /></div>)}
      </div>
    </div>
  </section>

  <PackageTeaser />
  <CtaBand />
</Base>

<style>
  .hero { background-color: var(--noir); background-size: cover; background-position: center; color: var(--ivory); padding-block: clamp(40px, 5vw, 64px) clamp(64px, 7vw, 100px); overflow: hidden; }
  .hero-grid { display: grid; grid-template-columns: minmax(0, 1fr) 640px; gap: 40px; align-items: center; }
  .hero-copy { display: flex; flex-direction: column; gap: 28px; }
  .hero .eyebrow { color: var(--champagne); letter-spacing: 0.3em; }
  .rule { width: 40px; height: 1px; background: var(--champagne); }
  h1 { font-weight: 400; font-size: clamp(44px, 5.3vw, 80px); line-height: 1; letter-spacing: -0.025em; color: var(--ivory); }
  h1 .foil { font-family: var(--italic); font-style: italic; font-weight: 500; font-size: 1.12em; }
  .sub { font-size: clamp(17px, 1.4vw, 19px); line-height: 1.6; color: #E4DDD5; max-width: 500px; }

  .collage { position: relative; width: 640px; height: 720px; }
  .stage { position: absolute; left: 0; top: 0; width: 640px; height: 700px; transform-origin: top left; }
  .arch-line { position: absolute; left: 172px; top: 12px; width: 416px; height: 616px; border: 1px solid var(--champagne); border-radius: 208px 208px 4px 4px; }
  .arch { position: absolute; left: 190px; top: 30px; width: 380px; height: 580px; border-radius: 190px 190px 4px 4px; overflow: hidden; box-shadow: 0 40px 80px rgba(0, 0, 0, 0.45); background: var(--blush); }
  .arch img { width: 100%; height: 100%; object-fit: cover; object-position: 55% 0%; }
  .browser { position: absolute; left: 0; top: 70px; width: 270px; border-radius: 8px; background: #FBFAF7; box-shadow: 0 24px 50px rgba(0, 0, 0, 0.45); overflow: hidden; color: var(--charcoal); }
  .bbar { display: flex; align-items: center; gap: 6px; padding: 9px 12px; background: #EFE9E2; } .bbar i { width: 7px; height: 7px; border-radius: 50%; background: var(--rose); } .bbar i:nth-child(2) { background: var(--champagne); } .bbar i:nth-child(3) { background: var(--dove); }
  .bbar span { margin-left: 8px; flex: 1; height: 16px; border-radius: 3px; background: #FBFAF7; font-size: 9px; line-height: 16px; padding-left: 8px; color: #6B6560; }
  .bhero { padding: 16px; background: linear-gradient(135deg, #FBEDEA 0%, #F4D9D7 100%); display: grid; gap: 5px; justify-items: start; }
  .bhero strong { font-family: var(--serif); font-weight: 500; font-size: 17px; line-height: 1.15; margin-bottom: 4px; } .bhero s { height: 5px; width: 80%; background: rgba(59, 58, 56, 0.18); border-radius: 3px; } .bhero s.short { width: 60%; margin-bottom: 7px; }
  .bhero em { font-style: normal; padding: 5px 12px; background: var(--noir); color: #FBFAF7; font-size: 8px; letter-spacing: 0.16em; text-transform: uppercase; border-radius: 2px; }
  .bgrid { padding: 10px 16px 14px; display: grid; grid-template-columns: repeat(3, 1fr); gap: 6px; } .bgrid i { height: 34px; border-radius: 3px; background: #EFE9E2; } .bgrid i:nth-child(2) { background: var(--blush); } .bgrid i:nth-child(3) { background: var(--gold-light); }
  .phone { position: absolute; left: 40px; top: 330px; width: 196px; height: 380px; border-radius: 30px; background: #0F0E0D; padding: 10px; box-shadow: 0 30px 60px rgba(0, 0, 0, 0.55); border: 1px solid #3A3532; }
  .screen { width: 100%; height: 100%; border-radius: 22px; background: #FBFAF7; overflow: hidden; color: var(--charcoal); padding: 14px 10px; }
  .ph-head { display: flex; align-items: center; gap: 8px; margin-bottom: 10px; } .ph-head span:last-child { display: grid; line-height: 1.2; } .ph-head b { font-size: 9px; font-weight: 600; } .ph-head small { font-size: 7px; color: #6B6560; }
  .av { width: 30px; height: 30px; border-radius: 50%; background: linear-gradient(180deg, #E8D3A2, #C8A96A); display: flex; align-items: center; justify-content: center; font-family: var(--italic); font-style: italic; font-size: 13px; color: var(--noir); }
  .ph-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 3px; } .ph-grid span { aspect-ratio: 4 / 5; padding: 5px; font-size: 7px; line-height: 1.15; display: flex; }
  .ph-grid .t { font-family: var(--serif); } .ph-grid .it { font-family: var(--italic); font-style: italic; font-size: 10px; align-items: center; justify-content: center; }
  .ph-grid .noir { background: var(--noir); color: var(--gold-light); } .ph-grid .blush { background: var(--blush); } .ph-grid .gold { background: var(--gold-light); } .ph-grid .linen { background: #EFE9E2; } .ph-grid .rose { background: var(--rose); }
  .serp { position: absolute; right: 0; top: 440px; width: 250px; border-radius: 8px; background: #FBFAF7; box-shadow: 0 24px 50px rgba(0, 0, 0, 0.45); padding: 14px; color: var(--charcoal); display: grid; gap: 4px; }
  .serp .q { display: flex; align-items: center; gap: 8px; padding: 7px 12px; border: 1px solid var(--dove); border-radius: 20px; font-size: 10px; margin-bottom: 8px; }
  .serp small { font-size: 8px; color: #6B6560; } .serp b { font-size: 12px; font-weight: 500; } .serp s { height: 4px; width: 90%; background: #E6DED7; border-radius: 2px; } .serp s.short { width: 70%; }
  .chips { position: absolute; right: 10px; top: 120px; display: flex; flex-direction: column; gap: 10px; align-items: flex-end; }
  .chips span { display: inline-flex; align-items: center; gap: 8px; padding: 9px 14px; background: rgba(29, 27, 26, 0.85); border: 1px solid rgba(200, 169, 106, 0.6); border-radius: 4px; font-size: 11px; letter-spacing: 0.06em; color: var(--ivory); }
  .illus { position: absolute; right: 0; bottom: 0; margin: 0; font-size: 10px; letter-spacing: 0.14em; text-transform: uppercase; color: #8C8580; }

  @media (max-width: 1240px) { .hero-grid { grid-template-columns: minmax(0, 1fr) 512px; } .collage { width: 512px; height: 576px; } .stage { transform: scale(0.8); } }
  @media (max-width: 1000px) {
    .hero-grid { grid-template-columns: minmax(0, 1fr); gap: 48px; }
    .collage { margin-inline: auto; }
  }
  @media (max-width: 600px) {
    .collage { width: 320px; height: 370px; }
    .stage { transform: scale(0.5); }
    .chips { display: none; }
    .illus { font-size: 9px; }
  }

  .intro { background: var(--white); padding-block: clamp(72px, 8vw, 104px); border-top: 1px solid #EFE6DD; }
  .intro-grid { display: grid; grid-template-columns: 380px minmax(0, 1fr); gap: 72px; align-items: center; }
  .intro-photo { position: relative; display: flex; justify-content: center; }
  .disc { position: absolute; bottom: 0; left: 50%; transform: translateX(-50%); width: 320px; height: 320px; border-radius: 50%; background: var(--blush); box-shadow: inset 0 0 0 1px rgba(200, 169, 106, 0.6); }
  .intro-photo img { position: relative; width: 340px; height: auto; -webkit-mask-image: linear-gradient(180deg, #000 85%, transparent); mask-image: linear-gradient(180deg, #000 85%, transparent); }
  @media (max-width: 860px) { .intro-grid { grid-template-columns: minmax(0, 1fr); gap: 40px; } .intro-photo img { width: 260px; } .disc { width: 250px; height: 250px; } }
  .work { background: var(--ivory); }
</style>
