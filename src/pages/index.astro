---
import { Image } from "astro:assets";
import Base from "../layouts/Base.astro";
import ProjectCard from "../components/ProjectCard.astro";
import CtaBand from "../components/CtaBand.astro";
import { site } from "../data/site";
import { projects } from "../data/projects";
import { services } from "../data/services";
import { packages, euro } from "../data/packages";
import hero from "../assets/photos/charlotte-smith-arms-folded.png";
import portrait from "../assets/photos/charlotte-smith-portrait.png";

const featured = ["general-copper-gold", "dar-il-fwieha", "ezsy-webs", "flooring-to-go", "moovly", "roc-kon-concrete"]
  .map((s) => projects.find((p) => p.slug === s)!);
const ribbon = ["Brand strategy", "Social media", "Websites", "SEO", "Paid advertising", "Email & CRM", "B2B lead generation", "Marketing consultancy"];
const menu = ["starter-social", "strategy-session", "wix-update", "linkedin-refresh"].map((id) => packages.find((p) => p.id === id)!);
---
<Base title={site.title} description={site.description}>
  <!-- Hero -->
  <section class="hero" aria-labelledby="hero-title">
    <div class="wrap hero-grid">
      <div class="hero-copy">
        <p class="eyebrow rise"><span class="star" aria-hidden="true">✦</span>Brand &amp; marketing consultant in Malta</p>
        <h1 id="hero-title" class="display rise d1">Marketing that looks as good as <span class="accent">your business</span> really is.</h1>
        <p class="lead rise d2">I'm Charlotte, a marketing and growth consultant with 9+ years shaping brands, building websites and running the campaigns, content, email and CRM that turn attention into enquiries.</p>
        <div class="btn-row rise d3">
          <a class="btn btn-dark" href="/work/">Explore my work</a>
          <a class="btn btn-line" href="/packages/">Packages from €45</a>
        </div>
        <dl class="facts rise d4">
          <div><dt>Years in marketing</dt><dd>9+</dd></div>
          <div><dt>Core services</dt><dd>8</dd></div>
          <div><dt>Packages from</dt><dd>€45</dd></div>
        </dl>
      </div>
      <div class="hero-photo fade-in">
        <span class="arch" aria-hidden="true"></span>
        <span class="arch-line" aria-hidden="true"></span>
        <Image src={hero} alt="Charlotte Smith smiling with arms folded, in a white linen top and gold jewellery" widths={[400, 600, 800, 1011]} sizes="(max-width: 960px) 80vw, 520px" loading="eager" fetchpriority="high" class="hero-img" />
      </div>
    </div>
  </section>

  <!-- Ribbon -->
  <div class="ribbon dark">
    <ul class="ticker" aria-label="What I do">
      {ribbon.map((r) => <li>{r}</li>)}
      {ribbon.map((r) => <li aria-hidden="true">{r}</li>)}
    </ul>
  </div>

  <!-- Work -->
  <section class="section" aria-labelledby="work-title">
    <div class="wrap stack-lg">
      <div class="head-row">
        <div class="stack" style="max-width: 680px; gap: 16px;">
          <p class="eyebrow">Selected work</p>
          <h2 id="work-title" class="h2">Brands, websites &amp; growth, <span class="accent">made with care.</span></h2>
        </div>
        <a class="textlink" href="/work/"><span>View all projects</span></a>
      </div>
      <div class="work-grid">
        {featured.map((p, i) => (
          <div class={`w${i} reveal`}><ProjectCard project={p} size={i === 0 ? "lg" : "md"} /></div>
        ))}
      </div>
    </div>
  </section>

  <!-- Services -->
  <section class="section band" aria-labelledby="svc-title">
    <div class="wrap stack-lg">
      <div class="head-row">
        <div class="stack" style="max-width: 640px; gap: 16px;">
          <p class="eyebrow">Services</p>
          <h2 id="svc-title" class="h2">Everything your marketing needs, <span class="accent">in one considered place.</span></h2>
        </div>
        <p style="max-width: 420px;">From your first logo to a full lead generation engine, I bring strategy and design together so every channel feels like the same brand.</p>
      </div>
      <ol class="svc-list rule-list">
        {services.map((s, i) => (
          <li class="reveal">
            <a href={`/services/${s.slug}/`}>
              <span class="num" aria-hidden="true">{String(i + 1).padStart(2, "0")}</span>
              <span class="svc-txt"><span class="svc-name">{s.name}</span><span class="svc-short">{s.short}</span></span>
              <svg class="svc-arrow" aria-hidden="true" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14M13 6l6 6-6 6"></path></svg>
            </a>
          </li>
        ))}
      </ol>
      <div class="ways">
        <div class="way way-feature">
          <p class="eyebrow" style="color: var(--espresso);">Buy today</p>
          <h3 class="h3">Fixed-price packages</h3>
          <p>Clear scope, set delivery times and fixed revisions. Choose a package, send your brief and I'll take it from there.</p>
          <a class="btn btn-dark btn-sm" href="/packages/">See packages</a>
        </div>
        <div class="way">
          <p class="eyebrow">Quoted for you</p>
          <h3 class="h3">Bespoke projects</h3>
          <p>Brand identities, websites and campaigns, scoped around your goals and timeline.</p>
          <a class="textlink" href="/contact/"><span>Request a quote</span></a>
        </div>
        <div class="way">
          <p class="eyebrow">Monthly</p>
          <h3 class="h3">Ongoing retainers</h3>
          <p>Steady support for social, SEO, ads, email and CRM, with a plan you can see.</p>
          <a class="textlink" href="/contact/"><span>Talk about support</span></a>
        </div>
      </div>
    </div>
  </section>

  <!-- Packages teaser -->
  <section class="section" aria-labelledby="pkg-title">
    <div class="wrap pkg-split">
      <div class="stack" style="gap: 18px;">
        <p class="eyebrow">Fixed-price packages</p>
        <h2 id="pkg-title" class="h2">Simple to choose, <span class="accent">lovely to receive.</span></h2>
        <p class="lead">Ten packages for the things businesses ask for most, from social graphics to a strategy session. Prices are fixed and in euros.</p>
        <div class="btn-row" style="margin-top: 8px;"><a class="btn btn-dark" href="/packages/">See all packages</a></div>
      </div>
      <ul class="pkg-menu card">
        {menu.map((p) => (
          <li>
            <a href={`/packages/#${p.id}`}>
              <span><span class="pkg-name">{p.name}</span><span class="pkg-line">{p.headline}</span></span>
              <span class="pkg-price">{euro(p.price)}</span>
            </a>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <!-- How it works -->
  <section class="section-tight" aria-labelledby="how-title" style="padding-top: 0;">
    <div class="wrap stack-lg">
      <h2 id="how-title" class="h3" style="font-size: 32px;">How it works</h2>
      <ol class="steps grid-3">
        <li><span class="roman" aria-hidden="true">i.</span><h3>Choose</h3><p>Pick a package, or tell me about a bespoke project or ongoing support.</p></li>
        <li><span class="roman" aria-hidden="true">ii.</span><h3>Brief</h3><p>Share your goals and assets. I confirm scope, timing and payment before anything starts.</p></li>
        <li><span class="roman" aria-hidden="true">iii.</span><h3>Receive</h3><p>Your work arrives on time, with the revisions your package includes.</p></li>
      </ol>
    </div>
  </section>

  <!-- About -->
  <section class="section band" aria-labelledby="about-title">
    <div class="wrap about-grid">
      <div class="about-photo reveal">
        <span class="panel" aria-hidden="true"></span>
        <span class="panel-line" aria-hidden="true"></span>
        <Image src={portrait} alt="Charlotte Smith looking into the distance, wearing a white linen top with gold and pearl necklaces" widths={[400, 600, 880]} sizes="(max-width: 960px) 80vw, 440px" class="about-img" />
      </div>
      <div class="stack" style="gap: 22px;">
        <p class="eyebrow">About me</p>
        <h2 id="about-title" class="h2">Strategy with a designer's eye, <span class="accent">and a calm pair of hands.</span></h2>
        <p>I've spent more than nine years in marketing, moving between brand strategy, social media, content, websites, campaigns, email and CRM. That range means I see how the pieces connect, so the marketing I build feels joined up rather than pieced together.</p>
        <p>I'm based in Malta and work with businesses that care how they come across. You'll get clear thinking, polished work and honest advice about what will actually move things forward.</p>
        <div style="display: flex; align-items: center; gap: 28px; flex-wrap: wrap; margin-top: 4px;">
          <span class="script" style="font-size: 44px;" aria-hidden="true">Charlotte</span>
          <a class="textlink" href="/about/"><span>More about me</span></a>
        </div>
      </div>
    </div>
  </section>

  <CtaBand />
</Base>

<style>
  .hero { position: relative; overflow: hidden; padding-top: clamp(40px, 6vw, 72px); }
  .hero-grid { display: grid; grid-template-columns: minmax(0, 1.1fr) minmax(0, 0.9fr); gap: 48px; align-items: end; }
  .hero-copy { display: flex; flex-direction: column; gap: 28px; padding-bottom: clamp(48px, 6vw, 80px); }
  .facts { display: flex; flex-wrap: wrap; gap: 20px 40px; margin: 12px 0 0; padding-top: 28px; border-top: 1px solid var(--dove); max-width: 560px; }
  .facts div { display: flex; flex-direction: column-reverse; }
  .facts dd { margin: 0; font-family: var(--serif); font-size: 34px; font-weight: 500; line-height: 1.1; }
  .facts dt { font-size: 12px; letter-spacing: 0.14em; text-transform: uppercase; color: var(--espresso); }
  .hero-photo { position: relative; display: flex; justify-content: center; align-items: flex-end; min-height: 520px; }
  .arch { position: absolute; bottom: 0; left: 50%; transform: translateX(-50%); width: 86%; max-width: 470px; height: 86%; background: var(--blush); border-radius: 240px 240px 0 0; }
  .arch-line { position: absolute; bottom: 0; left: 50%; transform: translateX(-50%); width: calc(86% + 36px); max-width: 506px; height: calc(86% + 18px); border: 1px solid var(--champagne); border-bottom: 0; border-radius: 260px 260px 0 0; }
  .hero-img { position: relative; width: 100%; max-width: 520px; height: auto; }
  @media (max-width: 960px) {
    .hero-grid { grid-template-columns: minmax(0, 1fr); gap: 8px; }
    .hero-copy { padding-bottom: 16px; }
    .hero-photo { min-height: 0; max-width: 460px; margin-inline: auto; width: 100%; }
  }

  .ribbon { overflow: hidden; padding: 22px 0; border-top: 1px solid var(--champagne); }
  .ticker { list-style: none; margin: 0; padding: 0; display: flex; width: max-content; gap: 0; font-family: var(--italic); font-style: italic; font-size: 26px; white-space: nowrap; }
  .ticker li { display: flex; align-items: center; }
  .ticker li::after { content: "✦"; font-style: normal; font-size: 14px; color: var(--champagne); margin: 0 36px; }
  @media (prefers-reduced-motion: no-preference) { .ticker { animation: tick 70s linear infinite; } }
  @media (prefers-reduced-motion: reduce) { .ticker { flex-wrap: wrap; width: auto; padding-inline: var(--gutter); white-space: normal; row-gap: 8px; } .ticker li[aria-hidden] { display: none; } }
  @keyframes tick { from { transform: translateX(0); } to { transform: translateX(-50%); } }

  .work-grid { display: grid; grid-template-columns: repeat(12, minmax(0, 1fr)); gap: 32px; }
  .w0 { grid-column: span 7; grid-row: span 2; }
  .w1, .w2 { grid-column: span 5; }
  .w3, .w4, .w5 { grid-column: span 4; }
  @media (max-width: 960px) { .w0, .w1, .w2, .w3, .w4, .w5 { grid-column: span 12; grid-row: auto; } }
  @media (min-width: 640px) and (max-width: 960px) { .w1, .w2, .w3, .w4 { grid-column: span 6; } }

  .svc-list { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); column-gap: 64px; }
  .svc-list li:nth-child(2) { border-top: 0; }
  .svc-list a { display: grid; grid-template-columns: 44px 1fr 28px; gap: 16px; align-items: start; padding: 26px 0; text-decoration: none; color: inherit; }
  .num { font-family: var(--italic); font-style: italic; font-size: 26px; line-height: 1.1; color: var(--bronze); }
  .svc-txt { display: flex; flex-direction: column; gap: 6px; }
  .svc-name { font-family: var(--serif); font-size: 21px; font-weight: 500; line-height: 1.3; }
  .svc-short { font-size: 15px; color: #5E5853; }
  .svc-arrow { margin-top: 4px; color: var(--bronze); transition: transform 240ms var(--ease); }
  .svc-list a:hover .svc-arrow { transform: translateX(4px); }
  .svc-list a:hover .svc-name { text-decoration: underline; text-decoration-color: var(--champagne); text-underline-offset: 5px; text-decoration-thickness: 1px; }
  @media (max-width: 760px) { .svc-list { grid-template-columns: minmax(0, 1fr); } .svc-list li:nth-child(2) { border-top: 0; } }

  .ways { display: grid; grid-template-columns: minmax(0, 1.25fr) minmax(0, 1fr) minmax(0, 1fr); gap: 24px; }
  .way { display: flex; flex-direction: column; align-items: flex-start; gap: 14px; padding: 36px; border: 1px solid var(--dove); border-radius: 8px; background: var(--ivory); }
  .way-feature { background: var(--blush); border-color: var(--blush); }
  .way .textlink, .way .btn { margin-top: auto; }
  @media (max-width: 960px) { .ways { grid-template-columns: minmax(0, 1fr); } }

  .pkg-split { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); gap: 64px; align-items: center; }
  @media (max-width: 960px) { .pkg-split { grid-template-columns: minmax(0, 1fr); gap: 40px; } }
  .pkg-menu { list-style: none; margin: 0; padding: 8px 32px; }
  .pkg-menu li + li { border-top: 1px solid var(--dove); }
  .pkg-menu a { display: flex; justify-content: space-between; align-items: center; gap: 20px; padding: 22px 0; text-decoration: none; color: inherit; }
  .pkg-name { display: block; font-family: var(--serif); font-size: 20px; font-weight: 500; }
  .pkg-line { display: block; font-size: 14px; color: #5E5853; }
  .pkg-price { font-family: var(--italic); font-style: italic; font-size: 32px; color: var(--espresso); white-space: nowrap; }
  .pkg-menu a:hover .pkg-name { text-decoration: underline; text-decoration-color: var(--champagne); text-underline-offset: 5px; text-decoration-thickness: 1px; }

  .steps { list-style: none; margin: 0; padding: 0; }
  .steps li { display: flex; flex-direction: column; gap: 10px; padding-top: 24px; border-top: 1px solid var(--champagne); }
  .steps h3 { font-size: 22px; }
  .roman { font-family: var(--italic); font-style: italic; font-size: 30px; line-height: 1; color: var(--bronze); }

  .about-grid { display: grid; grid-template-columns: minmax(0, 5fr) minmax(0, 7fr); gap: 72px; align-items: center; }
  @media (max-width: 960px) { .about-grid { grid-template-columns: minmax(0, 1fr); gap: 48px; } }
  .about-photo { position: relative; display: flex; justify-content: center; max-width: 480px; width: 100%; margin-inline: auto; }
  .panel { position: absolute; inset: 40px 6% 0; background: var(--blush); border-radius: 4px; }
  .panel-line { position: absolute; inset: 24px calc(6% - 16px) -16px; border: 1px solid var(--champagne); border-radius: 4px; }
  .about-img { position: relative; width: 100%; max-width: 440px; height: auto; }
</style>
