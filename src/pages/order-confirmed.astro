---
import Base from "../layouts/Base.astro";
---
<Base title="Order Confirmed | Charlotte Smith" description="Thank you for your order." noindex>
  <section class="page-hero">
    <div class="wrap stack" style="gap: 20px; max-width: 760px;">
      <p class="eyebrow"><span class="star" aria-hidden="true">✦</span>Order confirmed</p>
      <h1 class="display" style="font-size: clamp(38px, 4.6vw, 64px);">Thank you<span data-first></span>, <span class="accent">it's all in hand.</span></h1>
      <p class="lead" data-lead>Checking your payment…</p>
      <div class="btn-row" data-actions>
        <a class="btn btn-line" href="/">Back to home</a>
      </div>
    </div>
  </section>

  <section class="section" data-receipt hidden>
    <div class="wrap oc-grid">
      <div class="card rc">
        <h2 class="h3">Your receipt</h2>
        <ul class="rl" data-lines></ul>
        <p class="rt"><span>Total paid</span><strong data-total></strong></p>
        <p class="meta" data-meta></p>
      </div>
      <div class="stack" style="gap: 18px;">
        <h2 class="h3">What happens next</h2>
        <ol class="next">
          <li>I'll review your brief within one business day and let you know if I need anything else.</li>
          <li>Delivery times start once I have everything needed.</li>
          <li>Your finished work arrives by email, with your included revisions.</li>
        </ol>

      </div>
    </div>
  </section>
</Base>

<style is:global>
  .oc-grid { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); gap: 48px; align-items: start; }
  @media (max-width: 860px) { .oc-grid { grid-template-columns: minmax(0, 1fr); } }
  .rc { padding: 32px; display: grid; gap: 12px; }
  .rl { list-style: none; margin: 0; padding: 0; }
  .rl li { display: flex; justify-content: space-between; gap: 12px; padding: 12px 0; border-bottom: 1px solid var(--dove); }
  .rl small { display: block; color: #6B6560; font-size: 13px; }
  .rt { display: flex; justify-content: space-between; align-items: baseline; }
  .rt strong { font-family: var(--italic); font-style: italic; font-weight: 500; font-size: 36px; }
  .rl li.sub { padding: 8px 0; font-size: 15px; color: #4A4542; }
  .meta { font-size: 13px; color: #6B6560; overflow-wrap: anywhere; }
  .next { margin: 0; padding-left: 20px; display: grid; gap: 10px; }
</style>

<script>
  const m = (n: number) => `€${Number.isInteger(n) ? n : Number(n).toFixed(2)}`;
  const lead = document.querySelector<HTMLElement>("[data-lead]")!;
  const id = new URLSearchParams(location.search).get("session_id") ?? "";

  async function load(attempt = 0): Promise<void> {
    let r: any = null;
    try { r = await (await fetch(`/api/session/?id=${encodeURIComponent(id)}`, { cache: "no-store" })).json(); } catch { r = null; }
    if (r && r.paid === false && attempt < 5) { setTimeout(() => load(attempt + 1), 2000); return; }
    if (!r || !r.paid) {
      lead.textContent = r && r.paid === false
        ? "Your payment is still processing. You'll get a confirmation email as soon as it completes."
        : "Thank you for your order. Your confirmation email is on its way.";
      return;
    }
    // Paid: the cart and saved brief are no longer needed.
    if (!r.receipt.monthly) { try { localStorage.removeItem("cs-cart-v1"); window.dispatchEvent(new CustomEvent("cart:change")); } catch { /* ignore */ } }
    try { sessionStorage.removeItem("cs-checkout-draft"); } catch { /* ignore */ }

    if (r.first) document.querySelector("[data-first]")!.textContent = `, ${r.first}`;
    lead.textContent = `Your payment is complete. A welcome email with your receipt is on its way to ${r.email}.`;
    const lines = document.querySelector("[data-lines]")!;
    const li = (a: string, b: string, small = "", cls = "") => {
      const n = document.createElement("li"); if (cls) n.className = cls;
      const x = document.createElement("span"); x.textContent = a;
      if (small) { const d = document.createElement("small"); d.textContent = small; x.append(d); }
      const y = document.createElement("span"); y.textContent = b;
      n.append(x, y); lines.append(n);
    };
    r.receipt.items.forEach((i: any) => li(
      i.balance > 0 ? `${i.name}: 50% deposit` : i.name,
      `${m(i.amount)}${i.monthly ? " / month" : ""}`,
      i.balance > 0 ? `Balance ${m(i.balance)} + VAT invoiced on delivery` : i.monthly ? "Billed monthly. Cancel anytime." : i.delivery,
    ));
    li("Subtotal", m(r.receipt.subtotal), "", "sub");
    li(r.receipt.vatLabel || "VAT", m(r.receipt.vat), "", "sub");
    document.querySelector("[data-total]")!.textContent = m(r.receipt.total);
    document.querySelector("[data-meta]")!.textContent = `Order ${r.receipt.orderId} · ${r.receipt.date}. ${r.receipt.vatNote ? r.receipt.vatNote + " " : ""}Your VAT invoice will follow by email.`;
    document.querySelector<HTMLElement>("[data-receipt]")!.hidden = false;
    const actions = document.querySelector("[data-actions]")!;
    (r.bookings || []).slice().reverse().forEach((b: { url: string; label: string }) => {
      const a = document.createElement("a");
      a.className = "btn btn-gold"; a.href = b.url; a.target = "_blank"; a.rel = "noopener"; a.textContent = b.label;
      actions.prepend(a);
    });
  }
  if (id) load(); else lead.textContent = "Thank you for your order.";
</script>
