---
import Base from "../layouts/Base.astro";
---
<Base title="Message sent | Charlotte Smith" description="Your message has been sent." noindex>
  <section class="section">
    <div class="wrap stack center" style="max-width: 760px; text-align: center; gap: 22px;">
      <span style="color: var(--champagne); font-size: 20px;" aria-hidden="true">✦</span>
      <h1 class="display" style="font-size: clamp(40px, 5vw, 64px);">Thank you, <span class="accent">it's on its way.</span></h1>
      <p class="lead" style="margin-inline: auto;">Your message has been sent and I'll reply by email. If you sent a package order, no payment has been taken: I'll confirm the details and how to pay.</p>
      <div class="btn-row" style="justify-content: center;"><a class="btn btn-dark" href="/work/">Explore my work</a><a class="btn btn-line" href="/">Back to home</a></div>
    </div>
  </section>
</Base>
