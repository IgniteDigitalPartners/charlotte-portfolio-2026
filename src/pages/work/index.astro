---
import Base from "../../layouts/Base.astro";
import ProjectCard from "../../components/ProjectCard.astro";
import CtaBand from "../../components/CtaBand.astro";
import { projects } from "../../data/projects";
import { services } from "../../data/services";

const tags: Record<string, string> = {
  "social-media": "Social media",
  "brand-strategy-identity": "Branding",
  "marketing-strategy-consultancy": "Strategy",
  "website-design": "Websites",
  "email-marketing-crm": "Email & CRM",
  "b2b-lead-generation": "Lead generation",
  seo: "SEO",
  "paid-advertising": "Paid ads",
};
const filters =services.filter((s) => projects.some((p) => p.services.includes(s.slug)));
const itemList = {
  "@context": "https://schema.org",
  "@type": "ItemList",
  name: "Portfolio",
  itemListElement: projects.map((p, i) => ({ "@type": "ListItem", position: i + 1, url: new URL(`/work/${p.slug}/`, Astro.site!).href, name: p.client })),
};
---
<Base
  title="Portfolio | Brand, Website & Marketing Projects | Charlotte Smith"
  description="Selected brand identity, website, social media and marketing strategy projects by Charlotte Smith, a brand and marketing consultant in Malta."
  crumbs={[{ name: "Work", href: "/work/" }]}
  jsonLd={itemList}
>
  <section class="page-hero">
    <div class="wrap stack" style="gap: 22px; max-width: 980px; margin-inline: 0;">
      <p class="eyebrow"><span class="star" aria-hidden="true">✦</span>Portfolio</p>
      <h1 class="display">Work I'm <span class="accent">proud to share.</span></h1>
      <p class="lead">Brand identities, websites, social media and marketing strategy for businesses from Malta to the capital markets. Choose a project to see the brief, my role and what I delivered.</p>
    </div>
  </section>

  <section class="section" style="padding-top: 0;" aria-label="Projects">
    <div class="wrap stack-lg">
      <div class="filters" role="group" aria-label="Filter projects by service">
        <button type="button" class="chip filter" aria-pressed="true" data-filter="all">All work</button>
        {filters.map((s) => <button type="button" class="chip filter" aria-pressed="false" data-filter={s.slug}>{tags[s.slug] ?? s.name}</button>)}
      </div>
      <p class="sr-only" role="status" id="filter-status"></p>
      <ul class="pgrid">
        {projects.map((p, i) => (
          <li data-services={p.services.join(" ")}><ProjectCard project={p} eager={i < 2} /></li>
        ))}
      </ul>
    </div>
  </section>
  <CtaBand title="Have a project in mind?" accent="Let's talk." />
</Base>

<style>
  .filters { display: flex; flex-wrap: wrap; gap: 10px; }
  .filter { cursor: pointer; font-family: var(--sans); min-height: 44px; color: var(--charcoal); transition: background 240ms var(--ease), color 240ms var(--ease); }
  .filter:hover { background: var(--linen); }
  .filter[aria-pressed="true"] { background: var(--espresso); color: var(--warm-white); border-color: var(--espresso); }
  .pgrid { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 32px; }
  .pgrid li[hidden] { display: none; }
  @media (max-width: 760px) { .pgrid { grid-template-columns: minmax(0, 1fr); } }
</style>

<script>
  const buttons = document.querySelectorAll<HTMLButtonElement>(".filter");
  const items = document.querySelectorAll<HTMLLIElement>(".pgrid > li");
  const status = document.getElementById("filter-status")!;
  buttons.forEach((b) =>
    b.addEventListener("click", () => {
      const f = b.dataset.filter!;
      buttons.forEach((x) => x.setAttribute("aria-pressed", String(x === b)));
      let n = 0;
      items.forEach((li) => {
        const show = f === "all" || (li.dataset.services || "").split(" ").includes(f);
        li.hidden = !show;
        if (show) n++;
      });
      status.textContent = `Showing ${n} project${n === 1 ? "" : "s"}`;
    })
  );
</script>
