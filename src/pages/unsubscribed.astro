---
import Base from "../layouts/Base.astro";
---
<Base title="Unsubscribed | Charlotte Smith" description="You've been unsubscribed." noindex>
  <section class="section">
    <div class="wrap stack center" style="max-width: 760px; text-align: center; gap: 22px;">
      <span style="color: var(--champagne); font-size: 20px;" aria-hidden="true">✦</span>
      <h1 class="display" style="font-size: clamp(40px, 5vw, 64px);">You're <span class="accent">unsubscribed.</span></h1>
      <p class="lead" style="margin-inline: auto;">You won't receive any more follow-up emails about the checklist. Your checklist is still yours to use anytime.</p>
      <div class="btn-row" style="justify-content: center;"><a class="btn btn-dark" href="/free-audit/checklist/">Open the checklist</a><a class="btn btn-line" href="/">Back to home</a></div>
    </div>
  </section>
</Base>
