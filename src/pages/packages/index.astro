---
import Base from "../../layouts/Base.astro";
import CtaBand from "../../components/CtaBand.astro";
import { packages, groups, euro } from "../../data/packages";

const keys = Object.keys(groups) as (keyof typeof groups)[];
const ld = {
  "@context": "https://schema.org",
  "@type": "OfferCatalog",
  name: "Fixed-price marketing packages",
  itemListElement: packages.map((p) => ({
    "@type": "Offer",
    name: p.name,
    description: `${p.headline}. ${p.includes.join(", ")}.`,
    price: p.price,
    priceCurrency: "EUR",
    priceSpecification: { "@type": "PriceSpecification", price: p.price, priceCurrency: "EUR", valueAddedTaxIncluded: false },
    url: new URL(`/packages/#${p.id}`, Astro.site!).href,
    seller: { "@id": new URL("/#business", Astro.site!).href },
  })),
};
---
<Base
  title="Marketing Packages | Buy Online at Fixed Prices | Charlotte Smith"
  description="Buy fixed-price marketing packages online: social media graphics, Google Business Profile, brand starter kits, website support, audits, bundles and monthly social media."
  crumbs={[{ name: "Packages", href: "/packages/" }]}
  jsonLd={ld}
>
  <section class="page-hero">
    <div class="wrap stack center" style="gap: 20px; max-width: 900px; text-align: center;">
      <p class="eyebrow"><span class="star" aria-hidden="true">✦</span>Fixed-price packages</p>
      <h1 class="display">Simple to choose, <span class="accent">lovely to receive.</span></h1>
      <p class="lead" style="margin-inline: auto;">Clear scope, set delivery times and a fixed number of revisions. Prices are in euros and exclude VAT.</p>
      <nav class="jump" aria-label="Package groups">
        {keys.map((k) => <a class="chip" href={`#${k}`}>{groups[k].name}</a>)}
      </nav>
    </div>
  </section>

  <div class="wrap" style="padding-top: 40px;">
    <ol class="how" aria-label="How buying works">
      <li><span>i.</span><div><strong>Add to cart</strong><p>Choose one package or several.</p></div></li>
      <li><span>ii.</span><div><strong>Share your brief</strong><p>Answer a few questions so I can start straight away.</p></div></li>
      <li><span>iii.</span><div><strong>Pay securely</strong><p>By card, Apple Pay or Google Pay. Calls are paid in full; other one-off packages start with a 50% deposit.</p></div></li>
    </ol>
  </div>

  {keys.map((k, gi) => {
    const g = groups[k];
    const list = packages.filter((p) => p.group === k);
    return (
      <section id={k} class={`section ${gi % 2 === 1 ? "band" : ""}`} aria-labelledby={`${k}-title`}>
        <div class="wrap stack-lg">
          <div class="head-row">
            <div class="stack" style="gap: 12px; max-width: 620px;">
              <h2 id={`${k}-title`} class="h2">{g.name}</h2>
              <p class="lead">{g.intro}</p>
            </div>
            <dl class="g-notes">
              <div><dt>You provide</dt><dd>{g.youProvide}</dd></div>
              <div><dt>Good to know</dt><dd>{g.notes}</dd></div>
            </dl>
          </div>
          <ul class="pk">
            {list.map((p, i) => (
              <li id={p.id} class={`pkc ${k === "social" && i === 1 ? "feature" : "card"}`}>
                <h3>{p.name}</h3>
                <p class="price"><span class="sr-only">Price: </span>{euro(p.price)}{p.monthly && <span class="per"> a month</span>}</p>
                {p.bundle && <p class="saves">Save {euro(p.bundle.saves)}</p>}
                <p class="headline">{p.headline}</p>
                <ul class="ticks">{p.includes.map((x) => <li>{x}</li>)}</ul>
                <dl class="pk-facts">
                  <div><dt>Delivery</dt><dd>{p.delivery}</dd></div>
                  <div><dt>Revisions</dt><dd>{p.revisions}</dd></div>
                </dl>
                {p.monthly ? (
                  <a class="btn btn-dark" href={`/checkout/?plan=${p.id}`}>Subscribe<span class="sr-only">: {p.name}</span></a>
                ) : (
                  <button type="button" class={`btn add ${k === "social" && i === 1 ? "btn-light" : "btn-dark"}`} data-add={p.id} data-name={p.name}>Add to cart<span class="sr-only">: {p.name}</span></button>
                )}
              </li>
            ))}
          </ul>
        </div>
      </section>
    );
  })}

  <section class="section-tight" aria-labelledby="custom">
    <div class="wrap card custom">
      <div class="stack" style="gap: 12px;">
        <h2 id="custom" class="h3">Need something bigger?</h2>
        <p>Brand identities, websites, SEO, paid advertising, email and CRM are quoted to your scope, or available as a monthly retainer.</p>
      </div>
      <a class="btn btn-line" href="/contact/">Request a quote</a>
    </div>
  </section>

  <CtaBand />

  <div class="toast" role="status" aria-live="polite" hidden>
    <span data-toast-text></span>
    <a class="btn btn-sm btn-gold" href="/checkout/">View cart</a>
  </div>
</Base>

<script>
  import { add, has } from "../../scripts/cart";
  const toast = document.querySelector<HTMLElement>(".toast")!;
  const text = toast.querySelector<HTMLElement>("[data-toast-text]")!;
  let timer: number | undefined;
  const mark = (b: HTMLButtonElement) => { if (has(b.dataset.add!)) { b.firstChild!.textContent = "In your cart"; b.classList.add("added"); } };
  document.querySelectorAll<HTMLButtonElement>("[data-add]").forEach((b) => {
    mark(b);
    b.addEventListener("click", () => {
      add(b.dataset.add!);
      mark(b);
      text.textContent = `${b.dataset.name} is in your cart.`;
      toast.hidden = false;
      clearTimeout(timer);
      timer = window.setTimeout(() => (toast.hidden = true), 6000);
    });
  });
</script>

<style>
  .jump { display: flex; flex-wrap: wrap; justify-content: center; gap: 10px; margin-top: 8px; }
  .jump a { text-decoration: none; color: var(--charcoal); min-height: 44px; }
  .jump a:hover { background: var(--linen); }
  .g-notes { margin: 0; max-width: 460px; display: grid; gap: 14px; }
  .g-notes dt { font-size: 12px; font-weight: 500; letter-spacing: 0.16em; text-transform: uppercase; color: var(--espresso); }
  .g-notes dd { margin: 2px 0 0; font-size: 15px; }
  .pk { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(auto-fit, minmax(260px, 1fr)); gap: 28px; align-items: stretch; }
  .pkc { position: relative; display: flex; flex-direction: column; gap: 14px; padding: 36px 32px; border-radius: 8px; scroll-margin-top: 110px; }
  .pkc h3 { font-size: 24px; }
  .price { font-family: var(--italic); font-style: italic; font-size: 52px; line-height: 1; color: var(--espresso); }
  .headline { font-size: 15px; color: #5E5853; }
  .pkc .ticks { font-size: 15px; padding-top: 16px; border-top: 1px solid var(--dove); }
  .pk-facts { margin: 0; display: grid; gap: 6px; font-size: 14px; }
  .pk-facts div { display: flex; justify-content: space-between; gap: 12px; }
  .pk-facts dt { color: #5E5853; }
  .pk-facts dd { margin: 0; text-align: right; }
  .pkc .btn { margin-top: auto; }
  .feature { background: var(--espresso); color: var(--warm-white); box-shadow: var(--shadow-lifted); }
  .feature h3 { color: var(--champagne); }
  .feature .price { color: var(--blush); }
  .feature .headline, .feature .pk-facts dt { color: var(--dove); }
  .feature .ticks { border-top-color: rgba(200, 169, 106, 0.45); }
  .feature .ticks li::before { border-color: var(--champagne); }
  .badge { position: absolute; top: -13px; left: 32px; padding: 4px 12px; background: var(--champagne); color: var(--charcoal); font-size: 11px; font-weight: 500; letter-spacing: 0.16em; text-transform: uppercase; border-radius: 2px; }
  .per { font-size: 20px; }
  .saves { align-self: flex-start; padding: 4px 10px; border: 1px solid var(--champagne); border-radius: 2px; font-size: 12px; font-weight: 500; letter-spacing: 0.14em; text-transform: uppercase; color: var(--espresso); }
  button.add { cursor: pointer; font-family: var(--sans); }
  button.add.added { opacity: 0.85; }
  .how { list-style: none; margin: 0; padding: 28px 32px; display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 24px; background: var(--white); border: 1px solid var(--gold-edge); border-radius: 8px; }
  @media (max-width: 760px) { .how { grid-template-columns: minmax(0, 1fr); } }
  .how li { display: grid; grid-template-columns: 34px 1fr; gap: 10px; }
  .how span { font-family: var(--italic); font-style: italic; font-size: 26px; line-height: 1.1; color: var(--deep-rose); }
  .how strong { font-family: var(--serif); font-weight: 500; font-size: 19px; }
  .how p { font-size: 15px; color: #5E5853; }
  .toast { position: fixed; left: 50%; bottom: 24px; transform: translateX(-50%); z-index: 60; display: flex; align-items: center; gap: 18px; padding: 14px 16px 14px 22px; background: var(--noir); color: var(--ivory); border: 1px solid rgba(200, 169, 106, 0.45); border-radius: 4px; box-shadow: var(--shadow-card); max-width: calc(100vw - 32px); font-size: 15px; }
  .toast[hidden] { display: none; }
  .custom { display: flex; flex-wrap: wrap; justify-content: space-between; align-items: center; gap: 24px; padding: 36px; }
</style>
