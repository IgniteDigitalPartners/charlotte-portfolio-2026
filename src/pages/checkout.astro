---
import Base from "../layouts/Base.astro";
import { site } from "../data/site";
import { packages, briefSections } from "../data/packages";
import { euCountries, OUTSIDE_EU } from "../data/vat";
import { toLines } from "../lib/stripe";

// Calls are booked and paid on Calendly, so they never appear in the cart.
const inCart = packages.filter((p) => !p.calendly);
const catalog = toLines(inCart).map((l, i) => ({
  ...l,
  isCall: false,
  sections: briefSections(inCart[i]),
}));
---
<Base
  title="Your Cart | Charlotte Smith"
  description="Review your marketing packages, share your brief and pay securely online."
  crumbs={[{ name: "Packages", href: "/packages/" }, { name: "Cart", href: "/checkout/" }]}
  noindex
>
  <section class="page-hero slim">
    <div class="wrap stack" style="gap: 14px;">
      <p class="eyebrow"><span class="star" aria-hidden="true">✦</span>Checkout</p>
      <h1 class="display" style="font-size: clamp(38px, 4.6vw, 60px);">Your <span class="accent">cart.</span></h1>
    </div>
  </section>

  <section class="section" style="padding-top: 48px;">
    <div class="wrap">
      <div class="empty card" data-empty hidden>
        <h2 class="h3">Your cart is empty.</h2>
        <p>Choose a package to get started.</p>
        <a class="btn btn-dark" href="/packages/">Browse packages</a>
      </div>

      <form class="co-grid" data-form novalidate hidden>
        <div class="stack-lg">
          <fieldset class="card block">
            <legend class="h3">Your details</legend>
            <div class="form-row">
              <div class="field"><label for="c-name">Your name</label><input class="input" id="c-name" name="c::name" autocomplete="name" required /></div>
              <div class="field"><label for="c-email">Email</label><input class="input" id="c-email" name="c::email" type="email" autocomplete="email" required /><p class="hint">Your receipt and welcome email go here.</p></div>
            </div>
            <div class="form-row">
              <div class="field"><label for="c-business">Business name</label><input class="input" id="c-business" name="c::business" autocomplete="organization" required /></div>
              <div class="field"><label for="c-phone">Phone <span class="hint">(optional)</span></label><input class="input" id="c-phone" name="c::phone" type="tel" autocomplete="tel" /></div>
            </div>
            <div class="form-row">
              <div class="field">
                <label for="c-country">Country</label>
                <select class="input" id="c-country" name="c::country" required>
                  {euCountries.map((c) => <option value={c.code}>{c.name}</option>)}
                  <option value={OUTSIDE_EU}>Outside the EU</option>
                </select>
              </div>
              <div class="field" data-vatfield>
                <label for="c-vat">EU VAT number <span class="hint">(businesses, optional)</span></label>
                <input class="input" id="c-vat" name="c::vatNumber" autocomplete="off" placeholder="e.g. DE123456789" />
                <p class="hint">Businesses in the EU outside Malta: add your VAT number and VAT is reverse charged.</p>
              </div>
            </div>
          </fieldset>

          <div class="stack-lg" data-briefs></div>

          <fieldset class="card block welcome" data-welcome hidden>
            <legend class="h3">Your free welcome call</legend>
            <label class="check"><input type="checkbox" name="c::welcomeCall" value="yes" /><span>Yes, I'd like a free 30-minute welcome call to talk through my order.<br /><span class="hint">You choose a time straight after paying.</span></span></label>
          </fieldset>

          <fieldset class="card block">
            <legend class="h3">Anything else?</legend>
            <div class="field"><label for="c-notes">Notes <span class="hint">(optional)</span></label><textarea class="input" id="c-notes" name="c::notes" rows="3"></textarea></div>
          </fieldset>
        </div>

        <aside class="summary card" aria-labelledby="sum-title">
          <h2 id="sum-title" class="h3">Order summary</h2>
          <ul class="lines" data-lines></ul>
          <p class="sub-line"><span>Subtotal</span><span data-subtotal>€0</span></p>
          <p class="sub-line"><span data-vat-label>VAT 18%</span><span data-vat>€0</span></p>
          <p class="total"><span>Total</span><strong data-total>€0</strong></p>
          <p class="small" data-vat-note hidden></p>
          <p class="small warn" data-vat-warn hidden></p>
          <p class="small">Prices in euros. Delivery times start once your brief and files are received.</p>
          <label class="check terms"><input type="checkbox" name="c::terms" value="yes" required /><span>I agree to the <a href="/terms/" target="_blank">terms</a> and have read the <a href="/privacy/" target="_blank">privacy policy</a>.</span></label>

          <p class="small balance-note" data-balance-note hidden></p>
          <div data-pay hidden>
            <button type="button" class="btn btn-dark pay-btn" data-paybtn>Pay securely</button>
            <p class="small pay-note">You'll pay on Stripe's secure page: card, Apple Pay or Google Pay.</p>
            <p class="small test-note" data-test hidden>Test mode: use card 4242 4242 4242 4242, any future date and any CVC. No real money is taken.</p>
          </div>
          <div class="closed" data-closed hidden>
            <p class="small"><strong>Online payment opens soon.</strong> For now, send your order and brief and I'll reply within one business day with a secure payment link. Nothing is charged until you pay that link.</p>
            <button type="button" class="btn btn-dark send-brief" data-send>Send my order</button>
            <p class="ok" role="status" data-sent hidden></p>
          </div>
          <p class="err" role="alert" data-error hidden></p>
          <p class="small">Questions first? <a href={site.booking.discovery} target="_blank" rel="noopener">Book a free discovery call</a> or <a href="/contact/">send a message</a>.</p>
        </aside>
      </form>
    </div>
  </section>

  <script type="application/json" id="catalog" set:html={JSON.stringify(catalog)} />
</Base>

<style is:global>
  .empty[hidden], .co-grid[hidden] { display: none !important; }
  .co-grid .form-row { align-items: start; }
  .block legend.h3 { font-family: var(--serif); font-weight: 400; font-size: 26px; }
  .slim { padding-block: clamp(48px, 6vw, 72px) !important; }
  .empty { max-width: 560px; padding: 40px; display: grid; gap: 14px; justify-items: start; }
  .co-grid { display: grid; grid-template-columns: minmax(0, 1fr) 380px; gap: 40px; align-items: start; }
  @media (max-width: 980px) { .co-grid { grid-template-columns: minmax(0, 1fr); } .summary { position: static; } }
  .block { border: 1px solid var(--gold-edge); margin: 0; padding: clamp(22px, 3vw, 36px); display: grid; gap: 18px; min-width: 0; }
  .block legend { float: left; width: 100%; margin-bottom: 4px; padding: 0; }
  .block legend + * { clear: both; }
  .sec-sub { font-size: 14px; color: #6B6560; margin-top: -8px; }
  .summary { position: sticky; top: 104px; padding: 30px; display: grid; gap: 16px; }
  .lines { list-style: none; margin: 0; padding: 0; display: grid; }
  .lines li { display: grid; grid-template-columns: 1fr auto; gap: 4px 12px; padding: 14px 0; border-bottom: 1px solid var(--dove); }
  .lines .nm { font-family: var(--serif); font-size: 17px; }
  .lines .pr { white-space: nowrap; }
  .lines .rm { grid-column: 1 / -1; justify-self: start; background: none; border: 0; padding: 4px 0; font: inherit; font-size: 13px; color: #6B6560; text-decoration: underline; text-underline-offset: 3px; cursor: pointer; min-height: 32px; }
  .total { display: flex; justify-content: space-between; align-items: baseline; font-size: 15px; }
  .total strong { font-family: var(--italic); font-style: italic; font-weight: 500; font-size: 40px; line-height: 1; }
  .small { font-size: 13px; color: #6B6560; }
  .pay-note { margin-bottom: 10px; }
  .pay-btn { width: 100%; cursor: pointer; font-family: var(--sans); }
  .pay-btn[disabled] { opacity: 0.6; cursor: wait; }
  .test-note { padding: 10px 12px; border: 1px dashed var(--champagne); border-radius: 2px; }
  .test-note[hidden], .balance-note[hidden] { display: none; }
  .lines .note { grid-column: 1 / -1; font-size: 13px; color: #6B6560; }
  .err { padding: 12px 14px; border: 1px solid var(--deep-rose); border-radius: 2px; color: var(--deep-rose); font-size: 14px; }
  .err[hidden], [data-pay][hidden], [data-closed][hidden], .ok[hidden] { display: none; }
  .closed { display: grid; gap: 14px; }
  .sub-line { display: flex; justify-content: space-between; font-size: 15px; color: #4A4542; }
  .sub-line + .total { padding-top: 10px; border-top: 1px solid var(--dove); }
  .warn { color: var(--deep-rose); }
  .terms { font-size: 14px; }
  .terms input { width: 20px; height: 20px; }
  [data-vat-note][hidden], [data-vat-warn][hidden], [data-vatfield][hidden] { display: none; }
  .send-brief { width: 100%; cursor: pointer; font-family: var(--sans); }
  .ok { padding: 12px 14px; border: 1px solid var(--champagne); border-radius: 2px; font-size: 14px; background: var(--white); }
  .hint { font-size: 13px; color: #6B6560; }
  .welcome[hidden] { display: none; }
  .check { display: flex; gap: 14px; align-items: flex-start; font-size: 15px; cursor: pointer; }
  .check input { flex: none; width: 22px; height: 22px; margin-top: 2px; accent-color: var(--noir); }
  .block .field label { font-size: 15px; font-weight: 500; letter-spacing: 0; text-transform: none; color: var(--charcoal); }
  .block .field label .hint { font-weight: 400; }
  .block .field .hint { margin-top: -2px; }
</style>

<script>
  import { read, remove, clear } from "../scripts/cart";

  type Field = { name: string; label: string; type: string; required?: boolean; help?: string; options?: string[] };
  type Item = { id: string; name: string; price: number; amount: number; balance: number; monthly: boolean; delivery: string; isCall: boolean; sections: { id: string; name: string; fields: Field[] }[] };
  const catalog: Item[] = JSON.parse(document.getElementById("catalog")!.textContent || "[]");
  const byId = new Map(catalog.map((i) => [i.id, i]));

  const form = document.querySelector<HTMLFormElement>("[data-form]")!;
  const empty = document.querySelector<HTMLElement>("[data-empty]")!;
  const briefs = document.querySelector<HTMLElement>("[data-briefs]")!;
  const lines = document.querySelector<HTMLElement>("[data-lines]")!;
  const totalEl = document.querySelector<HTMLElement>("[data-total]")!;
  const errEl = document.querySelector<HTMLElement>("[data-error]")!;
  const DRAFT = "cs-checkout-draft";

  let draft: Record<string, string> = {};
  try { draft = JSON.parse(sessionStorage.getItem(DRAFT) || "{}"); } catch { draft = {}; }
  const saveDraft = () => { try { sessionStorage.setItem(DRAFT, JSON.stringify(draft)); } catch { /* ignore */ } };

  // A monthly plan checks out on its own (?plan=…); everything else comes from the cart.
  const params = new URLSearchParams(location.search);
  const plan = byId.get(params.get("plan") ?? "");
  const ids = () => (plan?.monthly ? [plan.id] : read().filter((id) => !byId.get(id)?.monthly));
  const items = () => ids().map((id) => byId.get(id)).filter((x): x is Item => Boolean(x));
  const el = <K extends keyof HTMLElementTagNameMap>(tag: K, props: Record<string, any> = {}, ...kids: (Node | string)[]) => {
    const n = document.createElement(tag);
    Object.entries(props).forEach(([k, v]) => (k === "class" ? (n.className = v) : k === "text" ? (n.textContent = v) : n.setAttribute(k, v)));
    kids.forEach((k) => n.append(k));
    return n;
  };

  function fieldNode(sectionId: string, f: Field) {
    const name = `brief::${sectionId}::${f.name}`;
    const id = name.replace(/[^a-z0-9]+/gi, "-");
    const label = el("label", { for: id }, f.label, ...(f.required ? [] : [el("span", { class: "hint", text: " (optional)" })]));
    let input: HTMLInputElement | HTMLTextAreaElement | HTMLSelectElement;
    if (f.type === "textarea") input = el("textarea", { class: "input", id, name, rows: "4" });
    else if (f.type === "select") {
      input = el("select", { class: "input", id, name }, el("option", { value: "", text: "Please choose" }), ...(f.options ?? []).map((o) => el("option", { value: o, text: o })));
    } else input = el("input", { class: "input", id, name, type: f.type === "url" ? "url" : "text", ...(f.type === "url" ? { inputmode: "url", placeholder: "https://" } : {}) });
    if (f.required) input.required = true;
    if (draft[name]) input.value = draft[name];
    const wrap = el("div", { class: "field" }, label, input);
    if (f.help) { const h = el("p", { class: "hint", id: `${id}-h`, text: f.help }); input.setAttribute("aria-describedby", h.id); wrap.append(h); }
    return wrap;
  }

  function render() {
    const list = items();
    empty.hidden = list.length > 0;
    form.hidden = list.length === 0;
    lines.replaceChildren(...list.map((i) => {
      const price = i.monthly ? `${money(i.amount)} / month` : money(i.amount);
      const note = i.balance > 0 ? `50% deposit today. Balance ${money(i.balance)} + VAT on delivery.` : i.monthly ? "Billed monthly. Cancel anytime." : "";
      const rm = plan
        ? el("a", { class: "rm", href: "/packages/#monthly", text: "Change plan" })
        : el("button", { type: "button", class: "rm", text: "Remove" });
      if (!plan) { rm.setAttribute("aria-label", `Remove ${i.name}`); rm.addEventListener("click", () => { remove(i.id); render(); }); }
      return el("li", {}, el("span", { class: "nm", text: i.balance > 0 ? `${i.name} (deposit)` : i.name }), el("span", { class: "pr", text: price }), ...(note ? [el("span", { class: "note", text: note })] : []), rm);
    }));
    paintTotals();
    const welcome = document.querySelector<HTMLElement>("[data-welcome]")!;
    welcome.hidden = !list.some((i) => !i.isCall);
    welcome.querySelector("input")!.disabled = welcome.hidden;
    briefs.replaceChildren(...list.flatMap((i) => i.sections.filter((s) => s.fields.length).map((s) =>
      el("fieldset", { class: "card block" }, el("legend", { class: "h3", text: s.name }), el("p", { class: "sec-sub", text: "What I need to complete this package." }), ...s.fields.map((f) => fieldNode(s.id, f))),
    )));
    form.querySelectorAll<HTMLInputElement>("[name^='c::']").forEach((n) => {
      if (n.type === "checkbox") n.checked = draft[n.name] === "yes";
      else if (draft[n.name] && !n.value) n.value = draft[n.name];
    });
  }

  // VAT: worked out on the server (it verifies EU VAT numbers), shown here.
  let vat = { rate: 0.18, label: "VAT 18%", note: "", warn: "" };
  const money = (n: number) => `€${Number.isInteger(n) ? n : n.toFixed(2)}`;
  function paintTotals() {
    const list = items();
    const sub = Math.round(list.reduce((n, i) => n + i.amount, 0) * 100) / 100;
    const tax = Math.round(list.reduce((n, i) => n + Math.round(i.amount * vat.rate * 100) / 100, 0) * 100) / 100;
    const bal = list.reduce((n, i) => n + i.balance, 0);
    const bn = document.querySelector<HTMLElement>("[data-balance-note]")!;
    bn.textContent = bal > 0 ? `Due today is your deposit. The remaining ${money(bal)} + VAT is invoiced when your work is delivered.` : "";
    bn.hidden = !bal;
    document.querySelector("[data-subtotal]")!.textContent = money(sub);
    document.querySelector("[data-vat-label]")!.textContent = vat.label;
    document.querySelector("[data-vat]")!.textContent = money(tax);
    totalEl.textContent = money(Math.round((sub + tax) * 100) / 100) + (list.some((i) => i.monthly) ? " / month" : "");
    const note = document.querySelector<HTMLElement>("[data-vat-note]")!; note.textContent = vat.note || ""; note.hidden = !vat.note;
    const warn = document.querySelector<HTMLElement>("[data-vat-warn]")!; warn.textContent = vat.warn || ""; warn.hidden = !vat.warn;
  }
  const countryEl = document.querySelector<HTMLSelectElement>("#c-country")!;
  const vatEl = document.querySelector<HTMLInputElement>("#c-vat")!;
  let quoteSeq = 0;
  async function quote() {
    const seq = ++quoteSeq;
    const showVatField = countryEl.value !== "MT" && countryEl.value !== "XX";
    document.querySelector<HTMLElement>("[data-vatfield]")!.hidden = !showVatField;
    try {
      const res = await fetch("/api/quote/", { method: "POST", headers: { "Content-Type": "application/json" }, body: JSON.stringify({ country: countryEl.value, vatNumber: showVatField ? vatEl.value : "" }) });
      const q = await res.json();
      if (seq !== quoteSeq) return;
      vat = { rate: q.rate, label: q.label, note: q.note ?? "", warn: q.warn ?? "" };
    } catch { /* keep the safe default: 18% */ }
    paintTotals();
  }
  countryEl.addEventListener("change", quote);
  vatEl.addEventListener("change", quote);
  if (draft["c::country"]) countryEl.value = draft["c::country"];
  quote();

  form.addEventListener("input", (e) => {
    const t = e.target as HTMLInputElement;
    if (t.name) { draft[t.name] = t.type === "checkbox" ? (t.checked ? "yes" : "") : t.value; saveDraft(); }
  });
  window.addEventListener("cart:change", render);
  render();

  function collect() {
    const data = new FormData(form);
    const customer: Record<string, string> = {};
    const brief: Record<string, Record<string, string>> = {};
    for (const [k, v] of data.entries()) {
      const parts = k.split("::");
      if (parts[0] === "c") customer[parts[1]] = String(v);
      if (parts[0] === "brief") (brief[parts[1]] ??= {})[parts[2]] = String(v);
    }
    return { customer, brief };
  }
  const briefAsText = () => [...form.querySelectorAll<HTMLElement>("[data-briefs] fieldset")].map((fs) => {
    const title = fs.querySelector("legend")?.textContent ?? "";
    const rows = [...fs.querySelectorAll<HTMLInputElement>("[name]")].map((n) => `${form.querySelector(`label[for="${n.id}"]`)?.firstChild?.textContent ?? n.name}: ${n.value || "(not answered)"}`);
    return [title, ...rows].join("\n");
  }).join("\n\n");

  // While online payment is paused: send the cart and brief by email instead.
  document.querySelector<HTMLButtonElement>("[data-send]")?.addEventListener("click", async (e) => {
    const btn = e.currentTarget as HTMLButtonElement;
    errEl.hidden = true;
    if (!items().length || !form.reportValidity()) return;
    const { customer } = collect();
    const list = items();
    const welcome = customer.welcomeCall === "yes" ? "\n\nWould like the free 30-minute welcome call." : "";
    btn.disabled = true; btn.textContent = "Sending…";
    try {
      const res = await fetch("/api/enquiry/", {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify({
          form_type: "order",
          name: customer.name, email: customer.email, business: customer.business,
          package: `${list.map((i) => `${i.name} (€${i.price}${i.monthly ? " a month" : ""})`).join(", ")}. Subtotal ${document.querySelector("[data-subtotal]")!.textContent}, ${vat.label} ${document.querySelector("[data-vat]")!.textContent}, total ${totalEl.textContent}`,
          message: `Country: ${countryEl.selectedOptions[0]?.textContent}${customer.vatNumber && vat.rate === 0 ? `\nVAT number: ${customer.vatNumber} (verified)` : ""}\n\n${briefAsText()}${customer.phone ? `\n\nPhone: ${customer.phone}` : ""}${customer.notes ? `\n\nNotes: ${customer.notes}` : ""}${welcome}`,
        }),
      });
      const out = await res.json().catch(() => ({}));
      if (!res.ok || !out.ok) throw new Error();
      try { sessionStorage.removeItem(DRAFT); } catch { /* ignore */ }
      const sent = document.querySelector<HTMLElement>("[data-sent]")!;
      clear();
      empty.hidden = false;
      empty.querySelector("h2")!.textContent = "Thank you, your order is on its way to me.";
      empty.querySelector("p")!.textContent = "A confirmation is in your inbox. I'll reply within one business day with your secure payment link and next steps. Nothing has been charged.";
      empty.scrollIntoView({ behavior: "smooth", block: "center" });
      sent.hidden = true;
    } catch {
      showError("Sorry, your order couldn't be sent. Please try again, or email hello@bycharlottesmith.com.");
    } finally {
      btn.disabled = false; btn.textContent = "Send my order";
    }
  });

  const showError = (msg: string) => { errEl.textContent = msg; errEl.hidden = false; };

  if (params.has("cancelled")) showError("Payment cancelled. Your cart and brief are saved, so you can try again.");

  // Stripe Checkout opens only when the server says payments, webhook and emails are configured.
  (async () => {
    let cfg = { ready: false, test: false };
    try { cfg = await (await fetch("/api/config/", { cache: "no-store" })).json(); } catch { /* stays closed */ }
    if (!cfg.ready) { document.querySelector<HTMLElement>("[data-closed]")!.hidden = false; return; }
    document.querySelector<HTMLElement>("[data-pay]")!.hidden = false;
    document.querySelector<HTMLElement>("[data-test]")!.hidden = !cfg.test;
  })();

  document.querySelector<HTMLButtonElement>("[data-paybtn]")!.addEventListener("click", async (e) => {
    const btn = e.currentTarget as HTMLButtonElement;
    errEl.hidden = true;
    if (!items().length || !form.reportValidity()) return;
    const { customer, brief } = collect();
    btn.disabled = true; btn.textContent = "Opening secure checkout…";
    try {
      const res = await fetch("/api/checkout/", { method: "POST", headers: { "Content-Type": "application/json" }, body: JSON.stringify({ items: ids(), customer: { ...customer, vatNumber: countryEl.value !== "MT" ? vatEl.value : "" }, brief }) });
      const out = await res.json().catch(() => ({}));
      if (!res.ok || !out.url) throw new Error(out.error || "Payment couldn't be started. Please try again.");
      location.href = out.url;
    } catch (err) {
      showError(err instanceof Error ? err.message : "Payment couldn't be started. Please try again.");
      btn.disabled = false; btn.textContent = "Pay securely";
    }
  });
</script>
