---
import "@fontsource/playfair-display/400.css";
import "@fontsource/playfair-display/500.css";
import "@fontsource/montserrat/300.css";
import "@fontsource/montserrat/400.css";
import "@fontsource/montserrat/500.css";
import "@fontsource/cormorant-garamond/400-italic.css";
import "@fontsource/cormorant-garamond/500-italic.css";
import "@fontsource/pinyon-script/400.css";
import "../styles/global.css";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import CookieBanner from "../components/CookieBanner.astro";
import { site } from "../data/site";

interface Props {
  title: string;
  description: string;
  image?: string;
  noindex?: boolean;
  jsonLd?: object | object[];
  crumbs?: { name: string; href: string }[];
  type?: "website" | "article";
}
const { title, description, image = "/og.jpg", noindex = false, jsonLd, crumbs, type = "website" } = Astro.props;
const siteUrl = Astro.site!;
const canonical = new URL(Astro.url.pathname, siteUrl).href;
const ogImage = new URL(image, siteUrl).href;

const business = {
  "@context": "https://schema.org",
  "@type": "ProfessionalService",
  "@id": new URL("/#business", siteUrl).href,
  name: "Charlotte Smith, Brand & Marketing Consultant",
  url: siteUrl.href,
  image: new URL("/og.jpg", siteUrl).href,
  logo: new URL("/icon-512.png", siteUrl).href,
  email: site.email,
  telephone: site.whatsapp.tel,
  description: site.description,
  areaServed: "Worldwide",
  priceRange: "€45 to €299 for fixed-price packages",
  founder: { "@id": new URL("/about/#charlotte", siteUrl).href },
  sameAs: site.sameAs,
};
const breadcrumbLd = crumbs && {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  itemListElement: [{ name: "Home", href: "/" }, ...crumbs].map((c, i) => ({
    "@type": "ListItem",
    position: i + 1,
    name: c.name,
    item: new URL(c.href, siteUrl).href,
  })),
};
const ld = [business, breadcrumbLd, ...(Array.isArray(jsonLd) ? jsonLd : jsonLd ? [jsonLd] : [])].filter(Boolean);
import Analytics from "@vercel/analytics/astro";
---
<!doctype html>
<html lang="en">
  <head>
    <!-- Google tag (gtag.js), loaded only after cookie consent -->
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      gtag('consent', 'default', { analytics_storage: 'denied', ad_storage: 'denied', ad_user_data: 'denied', ad_personalization: 'denied' });
      window.csLoadGtag = function () {
        if (window.csGtagLoaded) return;
        window.csGtagLoaded = true;
        gtag('consent', 'update', { analytics_storage: 'granted' });
        var s = document.createElement('script');
        s.async = true;
        s.src = 'https://www.googletagmanager.com/gtag/js?id=G-H05LQRNZWT';
        document.head.appendChild(s);
        gtag('js', new Date());
        gtag('config', 'G-H05LQRNZWT');
      };
      try { if (localStorage.getItem('cs-consent') === 'granted') window.csLoadGtag(); } catch (e) {}
    </script>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex, follow" />}
    <meta name="theme-color" content="#1D1B1A" />
<meta name="facebook-domain-verification" content="c9wava44kmnpiz5zguvv8ojyvu2vps" />
    <link rel="icon" href="/favicon.ico" sizes="48x48" />
    <link rel="icon" href="/favicon-32.png" sizes="32x32" type="image/png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <meta property="og:type" content={type} />
    <meta property="og:site_name" content="Charlotte Smith" />
    <meta property="og:locale" content="en_GB" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    {ld.map((d) => <script type="application/ld+json" set:html={JSON.stringify(d)} />)}
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <Header />
    <main id="main">
      {crumbs && (
        <div class="crumbs-bar"><nav class="crumbs wrap" aria-label="Breadcrumb" style="padding-top: 18px; padding-bottom: 4px;">
          <ol>
            <li><a href="/">Home</a></li>
            {crumbs.map((c, i) => (
              <li>{i === crumbs.length - 1 ? <span aria-current="page">{c.name}</span> : <a href={c.href}>{c.name}</a>}</li>
            ))}
          </ol>
        </nav></div>
      )}
      <slot />
    </main>
    <Footer />
    <CookieBanner />
    <script>
      const els = document.querySelectorAll<HTMLElement>(".reveal");
      if ("IntersectionObserver" in window) {
        const io = new IntersectionObserver(
          (entries) => entries.forEach((e) => { if (e.isIntersecting) { e.target.classList.add("is-visible"); io.unobserve(e.target); } }),
          { rootMargin: "0px 0px -8% 0px" }
        );
        els.forEach((el) => io.observe(el));
      } else els.forEach((el) => el.classList.add("is-visible"));
    </script>
      <Analytics />
  </body>
</html>
