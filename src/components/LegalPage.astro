---
import Base from "../layouts/Base.astro";
import { site } from "../data/site";
interface Props { title: string; heading: string; accent: string; description: string; path: string; updated: string }
const { title, heading, accent, description, path, updated } = Astro.props;
const l = site.legal;
---
<Base title={title} description={description} crumbs={[{ name: (heading + " " + accent).replace(/\.$/, ""), href: path }]}>
  <section class="page-hero slim-hero">
    <div class="wrap stack" style="gap: 14px;">
      <p class="eyebrow"><span class="star" aria-hidden="true">✦</span>Legal</p>
      <h1 class="display" style="font-size: clamp(38px, 4.6vw, 60px);">{heading} <span class="accent">{accent}</span></h1>
      <p class="lead">Last updated {updated}</p>
    </div>
  </section>
  <section class="section" style="padding-top: 56px;">
    <div class="wrap legal-grid">
      <article class="legal"><slot /></article>
      <aside class="card who">
        <h2 class="h3">Who I am</h2>
        <dl>
          <div><dt>Business</dt><dd>{l.tradingName}</dd></div>
          {l.address && <div><dt>Address</dt><dd>{l.address}</dd></div>}
          <div><dt>Registered in</dt><dd>{l.country}</dd></div>
          {l.vatNumber && <div><dt>VAT number</dt><dd>{l.vatNumber}</dd></div>}
          <div><dt>Email</dt><dd><a href={`mailto:${site.email}`}>{site.email}</a></dd></div>
        </dl>
      </aside>
    </div>
  </section>
</Base>

<style is:global>
  .slim-hero { padding-block: clamp(48px, 6vw, 80px) !important; }
  .legal-grid { display: grid; grid-template-columns: minmax(0, 1fr) 320px; gap: 56px; align-items: start; }
  @media (max-width: 960px) { .legal-grid { grid-template-columns: minmax(0, 1fr); } .who { order: -1; } }
  .legal { max-width: 760px; }
  .legal h2 { font-family: var(--serif); font-weight: 400; font-size: 28px; margin: 44px 0 14px; }
  .legal h2:first-child { margin-top: 0; }
  .legal h3 { font-family: var(--serif); font-weight: 500; font-size: 20px; margin: 26px 0 8px; }
  .legal p, .legal li { font-size: 16px; line-height: 1.75; }
  .legal p + p { margin-top: 12px; }
  .legal ul { margin: 10px 0 0; padding-left: 22px; display: grid; gap: 6px; }
  .legal a { text-underline-offset: 3px; }
  .who { position: sticky; top: 104px; padding: 28px; display: grid; gap: 14px; }
  @media (max-width: 960px) { .who { position: static; } }
  .who dl { margin: 0; display: grid; gap: 12px; }
  .who dt { font-size: 12px; font-weight: 500; letter-spacing: 0.16em; text-transform: uppercase; color: var(--espresso); }
  .who dd { margin: 2px 0 0; font-size: 15px; overflow-wrap: anywhere; }
</style>
