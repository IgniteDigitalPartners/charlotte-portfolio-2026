---
const items = ["Social media", "Brand identity", "Websites", "SEO", "Paid advertising", "Email & CRM", "B2B lead generation", "Marketing strategy"];
---
<div class="ticker-band">
  <ul class="ticker" aria-label="Marketing services">
    {items.map((t) => <li>{t}</li>)}
    {items.map((t) => <li aria-hidden="true">{t}</li>)}
  </ul>
</div>

<style>
  .ticker-band { overflow: hidden; padding: 22px 0; background: linear-gradient(180deg, #24211F 0%, var(--noir) 100%); border-top: 1px solid rgba(200, 169, 106, 0.45); }
  .ticker { list-style: none; margin: 0; padding: 0; display: flex; width: max-content; font-family: var(--italic); font-style: italic; font-weight: 500; font-size: clamp(22px, 2.4vw, 30px); color: var(--ivory); white-space: nowrap; }
  .ticker li { display: flex; align-items: center; }
  .ticker li::after { content: "✦"; font-style: normal; font-size: 14px; color: var(--champagne); margin: 0 36px; }
  @media (prefers-reduced-motion: no-preference) { .ticker { animation: tick 60s linear infinite; } }
  @media (prefers-reduced-motion: reduce) { .ticker { flex-wrap: wrap; width: auto; padding-inline: var(--gutter); white-space: normal; row-gap: 8px; } .ticker li[aria-hidden] { display: none; } }
  @keyframes tick { from { transform: translateX(0); } to { transform: translateX(-50%); } }
</style>
