---
import { packages, euro } from "../data/packages";
const from = Math.min(...packages.map((p) => p.price));
---
<section class="pk-sec texture-satin" aria-labelledby="pk-title">
  <div class="wrap inner">
    <h2 id="pk-title" class="h2 title">Marketing packages from <span class="accent">{euro(from)}.</span></h2>
    <p class="sub">Social media graphics, website support, audits and strategy sessions, all at fixed prices.</p>
    <div class="btn-row">
      <a class="btn btn-dark" href="/packages/">Browse packages</a>
      <a class="btn btn-line" href="/contact/">Start a project</a>
    </div>
  </div>
</section>

<style>
  .pk-sec { padding-block: clamp(80px, 9vw, 120px); }
  .inner { display: flex; flex-direction: column; align-items: center; text-align: center; gap: 22px; }
  .title { font-weight: 400; font-size: clamp(36px, 4.6vw, 60px); }
  .sub { font-size: 18px; max-width: 560px; color: #4A4542; }
  .btn-row { justify-content: center; margin-top: 6px; }
</style>
