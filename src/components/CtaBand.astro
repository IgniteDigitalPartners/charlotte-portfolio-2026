---
import { Image } from "astro:assets";
import { site } from "../data/site";
import foil from "../assets/brand/cs-gold-foil.png";
import marble from "../assets/textures/noir-marble.webp";
interface Props { title?: string; accent?: string; text?: string }
const {
  title = "Let's grow your business,",
  accent = "together.",
  text = "Tell me about your project, a package or the ongoing support you need. I'll reply with clear next steps.",
} = Astro.props;
---
<section class="cta" aria-labelledby="cta-title" style={`background-image: url(${marble.src});`}>
  <div class="wrap inner">
    <div class="copy">
      <h2 id="cta-title" class="big">{title} <span class="foil">{accent}</span></h2>
      <p>{text}</p>
      <div class="btn-row">
        <a class="btn btn-gold" href="/contact/">Book a call</a>
        <a class="btn btn-ghost" href="/packages/">Browse packages</a>
      </div>
      <p class="mail">Or email <a href={`mailto:${site.email}`}>{site.email}</a></p>
    </div>
    <Image src={foil} alt="" widths={[200, 320]} sizes="200px" class="mono" />
  </div>
</section>

<style>
  .cta { background-color: var(--noir); background-size: cover; background-position: center; color: var(--ivory); padding-block: clamp(80px, 10vw, 130px); border-top: 1px solid rgba(200, 169, 106, 0.35); }
  .inner { display: grid; grid-template-columns: minmax(0, 1fr) auto; align-items: center; gap: 48px; }
  .copy { display: flex; flex-direction: column; gap: 22px; }
  .big { font-family: var(--serif); font-weight: 400; font-size: clamp(42px, 6vw, 88px); line-height: 1; letter-spacing: -0.025em; color: var(--ivory); }
  .big .foil { font-family: var(--italic); font-style: italic; font-weight: 500; }
  .copy p { color: #E4DDD5; font-size: 18px; max-width: 560px; }
  .mail { font-size: 15px !important; }
  .mail a { color: var(--gold-light); text-underline-offset: 4px; overflow-wrap: anywhere; }
  .mono { width: 180px; height: auto; filter: drop-shadow(0 12px 28px rgba(0, 0, 0, 0.55)); }
  @media (max-width: 760px) { .inner { grid-template-columns: minmax(0, 1fr); } .mono { width: 110px; order: -1; } }
</style>
