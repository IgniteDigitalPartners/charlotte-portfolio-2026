---
import { site } from "../data/site";
import { services } from "../data/services";
import { packages, groups, euro } from "../data/packages";

interface Props { mode?: "contact" | "order"; id?: string }
const { mode = "contact", id = "enquiry-form" } = Astro.props;
const live = Boolean(site.formKey);
const thankYou = new URL("/thank-you/", Astro.site!).href;
const groupKeys = Object.keys(groups) as (keyof typeof groups)[];
---
<div class="form-wrap" data-mode={mode}>
  {!live && (
    <div class="notice" role="note" style="margin-bottom: 24px;">
      <svg aria-hidden="true" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="#4A3B33" stroke-width="1" stroke-linecap="round"><circle cx="12" cy="12" r="9"></circle><path d="M12 8v5M12 16.5v.01"></path></svg>
      <span>This form isn't connected yet, so it can't send messages. Please email <a href={`mailto:${site.email}`}>{site.email}</a> and I'll reply personally.</span>
    </div>
  )}
  <form id={id} class="form" action="https://api.web3forms.com/submit" method="POST" data-live={live ? "true" : "false"} novalidate>
    <input type="hidden" name="access_key" value={site.formKey} />
    <input type="hidden" name="subject" value={mode === "order" ? "New order brief from charlottesmith website" : "New enquiry from charlottesmith website"} />
    <input type="hidden" name="from_name" value="Charlotte Smith website" />
    <input type="hidden" name="form_type" value={mode === "order" ? "Package order brief" : "Enquiry"} />
    <input type="hidden" name="redirect" value={thankYou} />
    <input type="checkbox" name="botcheck" class="sr-only" tabindex="-1" autocomplete="off" aria-hidden="true" />

    {mode === "order" && (
      <div class="field">
        <label for={`${id}-package`}>Package</label>
        <select class="input" id={`${id}-package`} name="package" required>
          <option value="">Choose a package</option>
          {groupKeys.map((g) => (
            <optgroup label={groups[g].name}>
              {packages.filter((p) => p.group === g).map((p) => (
                <option value={`${p.name} (${euro(p.price)})`} data-id={p.id}>{p.name}, {euro(p.price)}</option>
              ))}
            </optgroup>
          ))}
        </select>
      </div>
    )}

    <div class="form-row">
      <div class="field">
        <label for={`${id}-name`}>Your name</label>
        <input class="input" id={`${id}-name`} name="name" type="text" autocomplete="name" required />
      </div>
      <div class="field">
        <label for={`${id}-email`}>Email</label>
        <input class="input" id={`${id}-email`} name="email" type="email" autocomplete="email" required />
      </div>
    </div>

    <div class="form-row">
      <div class="field">
        <label for={`${id}-business`}>Business name <span class="hint">(optional)</span></label>
        <input class="input" id={`${id}-business`} name="business" type="text" autocomplete="organization" />
      </div>
      <div class="field">
        <label for={`${id}-website`}>{mode === "order" ? "Website or profile link" : "Website"} <span class="hint">(optional)</span></label>
        <input class="input" id={`${id}-website`} name="website" type="url" inputmode="url" placeholder="https://" autocomplete="url" />
      </div>
    </div>

    {mode === "contact" && (
      <>
        <div class="form-row">
          <div class="field">
            <label for={`${id}-type`}>How would you like to work together?</label>
            <select class="input" id={`${id}-type`} name="engagement" required>
              <option value="">Choose one</option>
              <option>A fixed-price package</option>
              <option>A bespoke project</option>
              <option>Ongoing monthly support</option>
              <option>Not sure yet</option>
            </select>
          </div>
          <div class="field">
            <label for={`${id}-service`}>Main area of interest</label>
            <select class="input" id={`${id}-service`} name="service">
              <option value="">Choose a service</option>
              {services.map((s) => <option>{s.name}</option>)}
              <option>Something else</option>
            </select>
          </div>
        </div>
        <div class="field">
          <label for={`${id}-message`}>Tell me about your project</label>
          <textarea class="input" id={`${id}-message`} name="message" required placeholder="What you'd like to achieve, any deadlines and anything else that helps."></textarea>
        </div>
      </>
    )}

    {mode === "order" && (
      <>
        <div class="field">
          <label for={`${id}-brief`}>Your brief</label>
          <textarea class="input" id={`${id}-brief`} name="message" required placeholder="What you need, the platform or page, your goals and any style notes."></textarea>
        </div>
        <div class="form-row">
          <fieldset class="field" style="border: 0; padding: 0; margin: 0;">
            <legend>Are your copy, images and brand assets ready?</legend>
            <label class="choice"><input type="radio" name="assets_ready" value="Yes" required /> Yes, ready to share</label>
            <label class="choice"><input type="radio" name="assets_ready" value="Partly" /> Partly</label>
            <label class="choice"><input type="radio" name="assets_ready" value="No" /> Not yet</label>
          </fieldset>
          <div class="field">
            <label for={`${id}-date`}>Ideal start date <span class="hint">(optional)</span></label>
            <input class="input" id={`${id}-date`} name="start_date" type="date" />
          </div>
        </div>
      </>
    )}

    <p class="hint" style="font-size: 13px; color: #6B6560;">I'll only use your details to reply to you about this {mode === "order" ? "order" : "enquiry"}.</p>
    <div class="status" role="status" aria-live="polite" tabindex="-1"></div>
    <div>
      <button class="btn btn-dark" type="submit" disabled={!live}>{mode === "order" ? "Send order brief" : "Send enquiry"}</button>
    </div>
  </form>
</div>

<script>
  document.querySelectorAll<HTMLFormElement>("form[data-live]").forEach((form) => {
    const status = form.querySelector<HTMLElement>(".status")!;
    const btn = form.querySelector<HTMLButtonElement>('button[type="submit"]')!;
    const mode = form.closest<HTMLElement>(".form-wrap")?.dataset.mode;

    // Preselect a package from ?package=<id>
    const select = form.querySelector<HTMLSelectElement>('select[name="package"]');
    const wanted = new URLSearchParams(location.search).get("package");
    if (select && wanted) {
      const opt = select.querySelector<HTMLOptionElement>(`option[data-id="${CSS.escape(wanted)}"]`);
      if (opt) opt.selected = true;
    }

    const say = (state: "success" | "error" | "", text: string) => {
      status.dataset.state = state;
      status.textContent = text;
      if (text) status.focus();
    };

    form.addEventListener("submit", async (e) => {
      e.preventDefault();
      if (form.dataset.live !== "true") return;
      if (!form.checkValidity()) {
        form.reportValidity();
        return;
      }
      const data = Object.fromEntries(new FormData(form).entries());
      if (data.botcheck) return;
      delete data.redirect;
      btn.disabled = true;
      const label = btn.textContent;
      btn.textContent = "Sending…";
      say("", "");
      try {
        const res = await fetch("https://api.web3forms.com/submit", {
          method: "POST",
          headers: { "Content-Type": "application/json", Accept: "application/json" },
          body: JSON.stringify(data),
        });
        const json = await res.json().catch(() => ({}));
        if (res.ok && json.success) {
          form.reset();
          say(
            "success",
            mode === "order"
              ? `Thank you. Your order brief for ${data.package} has been sent. I'll reply by email to confirm the details and how to pay. No payment has been taken.`
              : "Thank you. Your message has been sent and I'll reply by email."
          );
        } else {
          throw new Error(json.message || `HTTP ${res.status}`);
        }
      } catch (err) {
        say("error", "Sorry, your message couldn't be sent. Please try again, or email charlotte.smith@ignitedigitalpartners.com.");
      } finally {
        btn.disabled = false;
        btn.textContent = label;
      }
    });
  });
</script>
