# Checkout opens on the site only when all PayPal and SMTP values are set (in Vercel > Settings > Environment Variables).

# PayPal REST app (developer.paypal.com > Apps & Credentials). Use the Live tab for real payments.
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
# "live" for real payments; anything else uses the PayPal sandbox.
PAYPAL_ENV=live

# Email for enquiries, the welcome email and order notifications (Google Workspace: use an app password).
SMTP_USER=charlotte.smith@ignitedigitalpartners.com
SMTP_PASS=
# Optional overrides
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=465
# NOTIFY_EMAIL=charlotte.smith@ignitedigitalpartners.com
